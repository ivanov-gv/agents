{
  "description": "Deliver mandatory skills by path/prompt (guidelines.json) for Claude Code and Codex, and give subagents the plugin's skill registry.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guidelines.mjs\"", "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guidelines.mjs\"", "timeout": 15}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guidelines.mjs\"", "timeout": 15}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|shell_command|shell|exec_command|Bash",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guidelines.mjs\"", "timeout": 15}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-subagent-skills.sh\""}
        ]
      }
    ]
  }
}
