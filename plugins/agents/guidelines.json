{
  "$comment": "Path scopes for `install.sh --claude-rules`, which writes each listed skill to a project's .claude/rules/agents-<skill>.md with `paths` frontmatter so Claude Code loads it when matching files are touched. `requires` lists files that must exist at the project root. The compliance-review skill also uses these scopes to decide which skills apply to a change. Skills not listed here are procedures loaded on demand.",
  "limits": {
    "guidelineMaxBytes": 10240
  },
  "guidelines": [
    {
      "skill": "code-general",
      "paths": ["**/*.go", "**/*.py", "**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.jsx", "**/*.rs", "**/*.java", "**/*.kt", "**/*.rb", "**/*.c", "**/*.h", "**/*.cpp", "**/*.cs", "**/*.swift", "**/*.sh", "**/*.ex", "**/*.exs"]
    },
    {
      "skill": "code-general-testing",
      "paths": ["**/*_test.go", "**/test_*.py", "**/*_test.py", "**/*.test.*", "**/*.spec.*", "**/tests/**", "**/__tests__/**", "**/testdata/**"]
    },
    {
      "skill": "code-golang-conventions",
      "paths": ["**/*.go", "**/go.mod", "**/go.sum", "**/go.work"]
    },
    {
      "skill": "code-golang-testing",
      "paths": ["**/*_test.go", "**/testdata/**"],
      "requires": ["go.mod"]
    },
    {
      "skill": "code-golang-lint",
      "paths": ["**/.golangci.yml", "**/.golangci.yaml", "**/.golangci.toml"]
    },
    {
      "skill": "code-golang-docker",
      "paths": ["**/Dockerfile", "**/Dockerfile.*", "**/*.Dockerfile", "**/docker-compose*.yml", "**/compose*.yaml", "**/deploy/**"],
      "requires": ["go.mod"]
    },
    {
      "skill": "cicd-github",
      "paths": [".github/workflows/**", ".github/actions/**"]
    },
    {
      "skill": "cicd-general",
      "paths": [".github/workflows/**", ".github/actions/**", ".gitlab-ci.yml", "**/.gitlab-ci.yml", "**/Jenkinsfile", ".circleci/**", "**/azure-pipelines.yml", "**/.woodpecker.yml", ".woodpecker/**"]
    },
    {
      "skill": "code-general-documentation",
      "paths": ["**/README.md", "**/AGENTS.md", "**/CLAUDE.md"]
    }
  ]
}
